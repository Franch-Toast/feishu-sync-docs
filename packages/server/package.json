{
  "name": "@feishu-sync/server",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && cp -R public dist/public",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "NODE_ENV=test tsx --test test/*.test.ts",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@feishu-sync/core": "workspace:*",
    "@feishu-sync/feishu": "workspace:*",
    "@feishu-sync/storage": "workspace:*",
    "@fastify/static": "^8.1.0",
    "@fastify/websocket": "^11.0.2",
    "chokidar": "^4.0.3",
    "fastify": "^5.2.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "@types/ws": "^8.5.14"
  }
}
